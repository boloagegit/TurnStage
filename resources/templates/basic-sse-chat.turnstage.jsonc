{
  "version": 1,
  "id": "basic-sse-chat",
  "name": "Basic SSE Chat",
  "description": "A minimal POST and SSE chat simulation profile.",
  "environment": "local",
  "controls": [{
    "id": "actor", "type": "select", "label": "Simulation Actor", "default": "actor-a", "persist": "workspace", "resetOnNewConversation": false,
    "options": [{ "label": "Test Actor A", "value": "actor-a" }, { "label": "Test Actor B", "value": "actor-b" }]
  }, {
    "id": "mode", "type": "select", "label": "Mock Scenario", "default": "normal", "persist": "workspace", "resetOnNewConversation": false,
    "options": [
      { "label": "Normal", "value": "normal" }, { "label": "Slow streaming", "value": "slow" },
      { "label": "Split network chunks", "value": "chunk-split" }, { "label": "Malformed JSON event", "value": "malformed-json" },
      { "label": "Unknown event", "value": "unknown-event" }, { "label": "Partial stream error", "value": "partial-error" },
      { "label": "HTTP 401", "value": "http-401" }, { "label": "HTTP 500", "value": "http-500" },
      { "label": "Idle timeout", "value": "idle-timeout" }, { "label": "Disconnect", "value": "disconnect" }
    ]
  }],
  "opening": {
    "mode": "static",
    "message": "Hello, I am a test assistant. What would you like to test?",
    "starters": [
      { "id": "starter-explain", "label": "Explain a sample topic", "prompt": "Please explain a sample topic.", "behavior": "send" },
      { "id": "starter-fill", "label": "Prepare a question", "prompt": "Please help me prepare a test question.", "behavior": "fill" }
    ]
  },
  "conversation": {
    "send": {
      "method": "POST", "url": "${env.baseUrl}/basic/chat/stream",
      "headers": { "Accept": "text/event-stream", "Content-Type": "application/json" },
      "variants": [
        { "id": "first-turn", "when": { "path": "conversation.id", "operator": "notExists" }, "body": { "mode": { "$value": "controls.mode" }, "actorId": { "$value": "controls.actor" }, "message": { "$value": "input.text" }, "openingMessage": { "$value": "opening.message" }, "clientRequestId": { "$value": "turn.clientRequestId" } } },
        { "id": "continuation", "when": { "path": "conversation.id", "operator": "exists" }, "body": { "mode": { "$value": "controls.mode" }, "actorId": { "$value": "controls.actor" }, "message": { "$value": "input.text" }, "conversationId": { "$value": "conversation.id" }, "interaction": { "$value": "turn.interaction" }, "clientRequestId": { "$value": "turn.clientRequestId" } } }
      ]
    },
    "stop": { "strategy": "abortThenRequest", "request": { "method": "POST", "url": "${env.baseUrl}/basic/chat/stop", "headers": { "Content-Type": "application/json" }, "body": { "conversationId": { "$value": "conversation.id" }, "assistantMessageId": { "$value": "turn.assistantMessageId" }, "clientRequestId": { "$value": "turn.clientRequestId" }, "reason": "user_cancel" } }, "requiredContext": ["conversation.id", "turn.assistantMessageId"], "onMissingContext": "localAbortWithWarning", "preservePartialContent": true, "appendSystemNotice": true }
  },
  "stream": {
    "transport": "sse", "dataFormat": "json", "mappingMode": "firstMatch", "unexpectedEndPolicy": "fail", "doneValue": "[DONE]",
    "mappings": [
      { "id": "start", "match": { "event": "start" }, "emit": { "type": "conversation.started", "conversationId": { "path": "$.conversationId" }, "assistantMessageId": { "path": "$.assistantMessageId" } } },
      { "id": "status", "match": { "event": "status" }, "emit": { "type": "progress.updated", "text": { "path": "$.text" } } },
      { "id": "message", "match": { "event": "message" }, "emit": { "type": "content.text.delta", "text": { "path": "$.text" } } },
      { "id": "title", "match": { "event": "title" }, "emit": { "type": "conversation.title.updated", "title": { "path": "$.title" } } },
      { "id": "done", "match": { "event": "done" }, "emit": { "type": "stream.completed" } },
      { "id": "error", "match": { "event": "error" }, "emit": { "type": "stream.failed", "error": { "path": "$" } } }
    ]
  },
  "ui": { "layout": { "preset": "split-inspector", "inspectorPosition": "right" }, "composer": { "placeholder": "Enter a test message...", "multiline": true, "enterBehavior": "send", "shiftEnterBehavior": "newline", "showStopWhileStreaming": true }, "streaming": { "effect": "caret", "speedMs": 900, "intensityPercent": 70 }, "locks": { "whileTurnActive": { "disable": ["composer", "actor", "mode", "newConversation", "environment"], "allow": ["stop", "configuration.open", "inspector.open", "message.copy"] } }, "components": { "opening": { "visible": true }, "progress": { "visible": true, "label": "Progress", "collapsible": true, "defaultCollapsed": false }, "citations": { "visible": false }, "toolCalls": { "visible": false }, "followups": { "visible": false }, "responseActions": { "visible": false }, "diagnostics": { "visible": true, "defaultCollapsed": true }, "metrics": { "visible": true } }, "messageActions": ["message.copy", "message.retry", "message.editAndResend", "message.inspectRaw"] },
  "tests": {
    "scenarios": [{
      "id": "basic-two-turn",
      "name": "Basic two-turn contract",
      "controls": { "actor": "actor-a", "mode": "normal" },
      "steps": [
        { "id": "first-turn", "name": "Create conversation", "input": "Explain the sample topic.", "assertions": [
          { "path": "turn.state", "operator": "equals", "value": "completed" },
          { "path": "conversation.id", "operator": "exists" },
          { "path": "assistant.text", "operator": "contains", "value": "sample result" },
          { "path": "events.normalized[*].type", "operator": "sequenceContains", "value": ["conversation.started", "progress.updated", "content.text.delta", "conversation.title.updated", "stream.completed"] }
        ] },
        { "id": "continuation", "name": "Continue conversation", "input": "Give me another detail.", "assertions": [
          { "path": "turn.state", "operator": "equals", "value": "completed" },
          { "path": "network[*].status", "operator": "contains", "value": 200 }
        ] }
      ],
      "assertions": [{ "path": "metrics.totalDuration", "operator": "lessThan", "value": 10000 }]
    }]
  },
  "history": { "localRuns": { "enabled": true, "maxRuns": 20, "recordRawEvents": true, "recordNormalizedEvents": true, "recordChatSnapshot": true } },
  "errorPolicy": { "preservePartialContent": true, "showErrorPart": true, "keepConversationId": true, "allowContinuation": true, "releaseAllLocks": true },
  "metrics": { "enabled": ["headersLatency", "firstChunkLatency", "firstEventLatency", "ttft", "streamDuration", "totalDuration", "eventCount", "byteCount", "averageEventGap", "maxEventGap", "parseErrorCount", "mappingErrorCount", "unmatchedEventCount"] }
}
