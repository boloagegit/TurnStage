{
  "$schema": "../../resources/schemas/turnstage-profile.schema.json",
  "version": 1,
  "id": "agent-flow",
  "name": "Agent Flow",
  "description": "A complete configurable AI chat and agent flow profile.",
  "environment": "local",
  "controls": [
    { "id": "actor", "type": "select", "label": "Simulation Actor", "default": "actor-a", "persist": "workspace", "resetOnNewConversation": false, "options": [{ "label": "Test Actor A", "value": "actor-a" }, { "label": "Test Actor B", "value": "actor-b" }] },
    { "id": "model", "type": "select", "label": "Model", "default": "default", "persist": "workspace", "options": [{ "label": "Default", "value": "default" }, { "label": "Fast", "value": "fast" }] },
    { "id": "mode", "type": "select", "label": "Mock Scenario", "default": "normal", "persist": "workspace", "options": [{ "label": "Normal", "value": "normal" }, { "label": "Slow streaming", "value": "slow" }, { "label": "Split network chunks", "value": "chunk-split" }, { "label": "Malformed JSON event", "value": "malformed-json" }, { "label": "Unknown event", "value": "unknown-event" }, { "label": "Partial stream error", "value": "partial-error" }, { "label": "HTTP 401", "value": "http-401" }, { "label": "HTTP 500", "value": "http-500" }, { "label": "Idle timeout", "value": "idle-timeout" }, { "label": "Disconnect", "value": "disconnect" }] },
    { "id": "debug", "type": "boolean", "label": "Debug", "default": false, "persist": "workspace" }
  ],
  "opening": {
    "mode": "request", "trigger": "sessionStart",
    "request": { "method": "POST", "url": "${env.baseUrl}/agent/opening", "headers": { "Content-Type": "application/json" }, "body": { "mode": { "$value": "controls.mode" }, "actorId": { "$value": "controls.actor" }, "scenarioId": "sample-scenario", "attributes": [{ "name": "testMode", "value": "true" }], "arguments": [{ "name": "sampleValue", "value": "1000" }] } },
    "response": { "messagePath": "$.message", "startersPath": "$.options" },
    "fallbacks": [{ "match": { "path": "$.code", "operator": "equals", "value": "OPENING_NOT_FOUND" }, "message": "Hello, I am a test assistant. What would you like to explore?", "starters": [{ "id": "starter-search", "label": "Search sample information", "prompt": "Please search for sample information.", "behavior": "send" }, { "id": "starter-prepare", "label": "Prepare a test request", "prompt": "Please help me prepare a test request.", "behavior": "fill" }] }],
    "failurePolicy": { "allowRetry": true, "useFallbackOnNetworkError": true }
  },
  "conversation": {
    "send": {
      "method": "POST", "url": "${env.baseUrl}/agent/chat/stream", "headers": { "Accept": "text/event-stream", "Content-Type": "application/json", "Authorization": "Bearer ${secret.apiToken}" }, "idleTimeoutMs": 30000, "timeoutMs": 120000,
      "variants": [
        { "id": "first-turn", "when": { "path": "conversation.id", "operator": "notExists" }, "body": { "mode": { "$value": "controls.mode" }, "actorId": { "$value": "controls.actor" }, "message": { "$value": "input.text" }, "openingMessage": { "$value": "opening.message" }, "model": { "$value": "controls.model" }, "debug": { "$value": "controls.debug" }, "interaction": { "$value": "turn.interaction" }, "clientRequestId": { "$value": "turn.clientRequestId" } } },
        { "id": "continuation", "when": { "path": "conversation.id", "operator": "exists" }, "body": { "mode": { "$value": "controls.mode" }, "actorId": { "$value": "controls.actor" }, "message": { "$value": "input.text" }, "conversationId": { "$value": "conversation.id" }, "model": { "$value": "controls.model" }, "debug": { "$value": "controls.debug" }, "interaction": { "$value": "turn.interaction" }, "clientRequestId": { "$value": "turn.clientRequestId" } } }
      ]
    },
    "stop": { "strategy": "abortThenRequest", "request": { "method": "POST", "url": "${env.baseUrl}/agent/chat/stop", "headers": { "Content-Type": "application/json" }, "body": { "conversationId": { "$value": "conversation.id" }, "assistantMessageId": { "$value": "turn.assistantMessageId" }, "clientRequestId": { "$value": "turn.clientRequestId" }, "reason": "user_cancel" } }, "requiredContext": ["conversation.id", "turn.assistantMessageId"], "onMissingContext": "localAbortWithWarning", "preservePartialContent": true, "appendSystemNotice": true }
  },
  "stream": {
    "transport": "sse", "dataFormat": "json", "mappingMode": "firstMatch", "unexpectedEndPolicy": "fail", "doneValue": "[DONE]",
    "mappings": [
      { "id": "start", "match": { "event": "start" }, "emit": { "type": "conversation.started", "conversationId": { "path": "$.conversationId" }, "assistantMessageId": { "path": "$.assistantMessageId" } } },
      { "id": "status", "match": { "event": "status" }, "emit": { "type": "progress.updated", "text": { "path": "$.text" } } },
      { "id": "message", "match": { "event": "message" }, "emit": { "type": "content.markdown.delta", "text": { "path": "$.text" } } },
      { "id": "tool-call", "match": { "event": "tool_call" }, "emit": { "type": "tool.started", "toolCallId": { "path": "$.toolCallId" }, "name": { "path": "$.name" }, "arguments": { "path": "$.arguments" } } },
      { "id": "tool-result", "match": { "event": "tool_result" }, "emit": { "type": "tool.completed", "toolCallId": { "path": "$.toolCallId" }, "result": { "path": "$.result" } } },
      { "id": "citation", "match": { "event": "citation" }, "emit": { "type": "citation.upsert", "citation": { "path": "$" } } },
      { "id": "inline-citation", "match": { "event": "citation_reference" }, "emit": { "type": "content.citation", "citationId": { "path": "$.citationId" } } },
      { "id": "action", "match": { "event": "action" }, "emit": { "type": "action.upsert", "action": { "path": "$" } } },
      { "id": "form", "match": { "event": "form" }, "emit": { "type": "form.upsert", "form": { "path": "$" } } },
      { "id": "followup", "match": { "event": "followup" }, "emit": { "type": "followup.upsert", "followup": { "path": "$" } } },
      { "id": "diagnostic", "match": { "event": "diagnostic" }, "emit": { "type": "diagnostic.updated", "diagnostic": { "path": "$" } } },
      { "id": "usage", "match": { "event": "usage" }, "emit": { "type": "usage.updated", "usage": { "path": "$" } } },
      { "id": "title", "match": { "event": "title" }, "emit": { "type": "conversation.title.updated", "title": { "path": "$.title" } } },
      { "id": "done", "match": { "event": "done" }, "emit": { "type": "stream.completed" } },
      { "id": "error", "match": { "event": "error" }, "emit": { "type": "stream.failed", "error": { "path": "$" } } }
    ]
  },
  "ui": { "layout": { "preset": "split-inspector", "inspectorPosition": "right", "inspectorWidth": 360 }, "composer": { "placeholder": "Enter a test message...", "multiline": true, "enterBehavior": "send", "shiftEnterBehavior": "newline", "showStopWhileStreaming": true }, "locks": { "whileTurnActive": { "disable": ["composer", "actor", "model", "mode", "newConversation", "environment", "history.apply"], "allow": ["stop", "history.open", "configuration.open", "inspector.open", "message.copy"] } }, "components": { "opening": { "visible": true }, "progress": { "visible": true, "label": "Progress", "collapsible": true, "defaultCollapsed": false }, "toolCalls": { "visible": true, "collapsible": true, "defaultCollapsed": true }, "citations": { "visible": true, "inline": true, "showSourcesPanel": true }, "followups": { "visible": true, "maxVisible": 3 }, "responseActions": { "visible": true, "maxPrimaryActions": 1 }, "forms": { "visible": true }, "diagnostics": { "visible": true, "defaultCollapsed": true }, "metrics": { "visible": true } }, "messageActions": ["message.copy", "message.retry", "message.editAndResend", "message.inspectRaw"] },
  "history": { "remoteSessions": { "mode": "referenceOnly", "scope": ["profile", "actor", "environment"] }, "localRuns": { "enabled": true, "maxRuns": 20, "recordRawEvents": true, "recordNormalizedEvents": true, "recordChatSnapshot": true } },
  "errorPolicy": { "preservePartialContent": true, "showErrorPart": true, "keepConversationId": true, "allowContinuation": true, "releaseAllLocks": true },
  "security": { "allowedUriSchemes": ["https", "http", "file"], "allowedDomains": ["example.com"], "allowedCommands": ["vscode.open"] },
  "metrics": { "enabled": ["headersLatency", "firstChunkLatency", "firstEventLatency", "ttft", "streamDuration", "totalDuration", "eventCount", "byteCount", "averageEventGap", "maxEventGap", "parseErrorCount", "mappingErrorCount", "unmatchedEventCount"] }
}
