{
  "version": 1,
  "id": "enterprise-chat",
  "name": "Enterprise Chat Contract",
  "description": "Synthetic first-turn, multi-turn, stop, error, CTA, form, and diagnostic contract testing.",
  "environment": "local",
  "controls": [
    { "id": "actor", "type": "select", "label": "Test User", "default": "synthetic-user-a", "persist": "global", "resetOnNewConversation": false, "options": [{ "label": "Synthetic User A", "value": "synthetic-user-a" }, { "label": "Synthetic User B", "value": "synthetic-user-b" }] },
    { "id": "mode", "type": "select", "label": "Mock Scenario", "default": "normal", "persist": "workspace", "options": [{ "label": "Normal", "value": "normal" }, { "label": "Slow streaming", "value": "contract-slow" }, { "label": "Service error", "value": "contract-error" }, { "label": "Actions and unknown event", "value": "contract-actions" }, { "label": "Opening options", "value": "opening-options" }] }
  ],
  "opening": {
    "mode": "request",
    "trigger": "sessionStart",
    "request": {
      "method": "POST",
      "url": "${env.baseUrl}/v1/chat/opening",
      "headers": { "Content-Type": "application/json", "X-TurnStage-Mode": "${controls.mode}" },
      "body": {
        "actorId": { "$value": "controls.actor" },
        "taskId": "DEMO_OPENING_TASK",
        "blockId": "DEMO_BLOCK",
        "tags": [{ "attrName": "Test", "attrValue": "Y" }],
        "openingMsgArgs": [{ "placeholder": "sampleValue", "value": "123456" }]
      }
    },
    "response": { "messagePath": "$.openingMessage", "startersPath": "$.optionsInfo" },
    "fallbacks": [{ "match": { "path": "$.code", "operator": "equals", "value": 7021 }, "message": "Hello, I am a synthetic test assistant. How can I help?" }],
    "failurePolicy": { "allowRetry": true, "useFallbackOnNetworkError": true }
  },
  "conversation": {
    "send": {
      "method": "POST",
      "url": "${env.baseUrl}/v1/chat/stream",
      "headers": { "Accept": "text/event-stream", "Content-Type": "application/json", "X-TurnStage-Mode": "${controls.mode}" },
      "idleTimeoutMs": 30000,
      "timeoutMs": 120000,
      "variants": [
        {
          "id": "first-turn",
          "when": { "path": "conversation.id", "operator": "notExists" },
          "body": {
            "actorId": { "$value": "controls.actor" },
            "message": { "$value": "input.text", "$transforms": ["trim"] },
            "openingMessage": { "content": { "$value": "opening.message" } },
            "conversationProfile": {
              "customerReference": "SYNTHETIC_CUSTOMER",
              "userReference": "SYNTHETIC_USER",
              "sessionProof": "SYNTHETIC_PROOF_${turn.startedAt}"
            }
          }
        },
        {
          "id": "continuation",
          "when": { "path": "conversation.id", "operator": "exists" },
          "body": {
            "actorId": { "$value": "controls.actor" },
            "message": { "$value": "input.text", "$transforms": ["trim"] },
            "cid": { "$value": "conversation.id" },
            "interaction": { "$value": "turn.interaction" }
          }
        }
      ]
    },
    "stop": {
      "strategy": "abortThenRequest",
      "request": {
        "method": "POST",
        "url": "${env.baseUrl}/v1/chat/stop",
        "headers": { "Content-Type": "application/json" },
        "body": {
          "cid": { "$value": "conversation.id" },
          "assistantMessageId": { "$value": "turn.assistantMessageId" },
          "reason": "user_cancel"
        }
      },
      "requiredContext": ["conversation.id", "turn.assistantMessageId"],
      "onMissingContext": "localAbortWithWarning",
      "preservePartialContent": true,
      "appendSystemNotice": true
    }
  },
  "stream": {
    "transport": "sse",
    "dataFormat": "json",
    "mappingMode": "firstMatch",
    "unexpectedEndPolicy": "fail",
    "mappings": [
      { "id": "start", "match": { "event": "start" }, "emit": { "type": "conversation.started", "conversationId": { "path": "$.cid" }, "assistantMessageId": { "path": "$.assistantMessageId" } } },
      { "id": "status", "match": { "event": "status" }, "emit": { "type": "progress.updated", "text": { "path": "$.text" } } },
      { "id": "message", "match": { "event": "message" }, "emit": { "type": "content.markdown.delta", "text": { "path": "$.text" } } },
      { "id": "followup", "match": { "event": "followup" }, "emit": { "type": "followup.upsert", "followup": { "path": "$" } } },
      { "id": "action-request", "match": { "event": "action", "path": "$.actionId", "operator": "equals", "value": "request.send" }, "emit": { "type": "action.upsert", "action": { "id": { "path": "$.id" }, "label": { "path": "$.label" }, "actionId": "request.send", "payload": { "text": { "path": "$.payload.messageText" }, "interactionKey": { "path": "$.payload.ctaKey" } } } } },
      { "id": "action-uri", "match": { "event": "action", "path": "$.actionId", "operator": "equals", "value": "uri.open" }, "emit": { "type": "action.upsert", "action": { "id": { "path": "$.id" }, "label": { "path": "$.label" }, "actionId": "uri.open", "payload": { "uri": { "path": "$.payload.uri" }, "interactionKey": { "path": "$.payload.ctaKey" } } } } },
      { "id": "diagnostic", "match": { "event": "diagnostic" }, "continue": true, "emit": { "type": "diagnostic.updated", "diagnostic": { "path": "$" } } },
      { "id": "message-e2e", "match": { "event": "diagnostic" }, "emit": { "type": "message.metric.updated", "metric": { "id": "e2e", "label": "E2E", "value": { "path": "$.e2e_ms" }, "unit": "ms", "format": "duration", "aggregation": "last" } } },
      { "id": "title", "match": { "event": "title" }, "emit": { "type": "conversation.title.updated", "title": { "path": "$.title" } } },
      { "id": "done", "match": { "event": "done" }, "emit": { "type": "stream.completed" } },
      { "id": "error", "match": { "event": "error" }, "emit": { "type": "stream.failed", "error": { "path": "$.message" } } }
    ]
  },
  "ui": {
    "layout": { "preset": "split-inspector", "inspectorPosition": "right", "inspectorWidth": 360 },
    "composer": { "placeholder": "Enter a test message...", "multiline": true, "enterBehavior": "send", "shiftEnterBehavior": "newline", "showStopWhileStreaming": true },
    "streaming": { "effect": "shimmer", "speedMs": 1000, "intensityPercent": 70 },
    "messageActionVisibility": "always",
    "locks": { "whileTurnActive": { "disable": ["composer", "actor", "mode", "newConversation", "environment", "history.apply"], "allow": ["stop", "history.open", "configuration.open", "inspector.open"] } },
    "components": { "opening": { "visible": true }, "progress": { "visible": true }, "followups": { "visible": true, "maxVisible": 3 }, "responseActions": { "visible": true, "maxPrimaryActions": 1 }, "forms": { "visible": true }, "diagnostics": { "visible": true }, "metrics": { "visible": true }, "messageMetrics": { "visible": true } }
  },
  "history": { "remoteSessions": { "mode": "referenceOnly", "scope": ["profile", "actor", "environment"] }, "localRuns": { "enabled": true, "maxRuns": 20, "recordRawEvents": true, "recordNormalizedEvents": true, "recordChatSnapshot": true } },
  "errorPolicy": { "preservePartialContent": true, "showErrorPart": true, "keepConversationId": true, "allowContinuation": true, "releaseAllLocks": true },
  "security": { "allowedUriSchemes": ["https"], "allowedDomains": ["example.com"], "allowedCommands": [] },
  "metrics": { "enabled": ["headersLatency", "firstEventLatency", "ttft", "totalDuration", "eventCount", "byteCount"], "messageEnabled": ["ttft", "totalDuration", "e2e"] }
}
