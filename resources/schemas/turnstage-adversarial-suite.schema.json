{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turnstage.dev/schemas/turnstage-adversarial-suite.schema.json",
  "title": "TurnStage Adversarial Test Suite",
  "type": "object",
  "required": ["format", "version", "id", "name", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "turnstage-adversarial-suite" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "defaults": { "$ref": "#/$defs/defaults" },
    "cases": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxTurns": { "type": "integer", "minimum": 1, "maximum": 10 },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "stopOnAttackSucceeded": { "type": "boolean" },
        "forbid": { "$ref": "#/$defs/forbid" }
      }
    },
    "case": {
      "type": "object",
      "required": ["id", "name", "turns"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tags": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "enabled": { "type": "boolean" },
        "controls": { "type": "object", "additionalProperties": true },
        "mode": { "enum": ["singleTurn", "multiTurn"] },
        "maxTurns": { "type": "integer", "minimum": 1, "maximum": 10 },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "stopOnAttackSucceeded": { "type": "boolean" },
        "forbid": { "$ref": "#/$defs/forbid" },
        "turns": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/turn" } }
      }
    },
    "turn": {
      "type": "object",
      "required": ["id", "input"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string" },
        "input": { "type": "string", "minLength": 1 },
        "additionalForbid": { "$ref": "#/$defs/forbid" }
      }
    },
    "forbid": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": { "type": "array", "maxItems": 50, "items": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 256 }, { "$ref": "#/$defs/contentRule" }] } },
        "urls": { "type": "boolean" },
        "ctas": { "type": "boolean" },
        "tools": { "type": "boolean" },
        "events": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
      }
    },
    "contentRule": {
      "type": "object",
      "required": ["match", "value"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "match": { "enum": ["contains", "regex"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 256 },
        "caseSensitive": { "type": "boolean" }
      }
    }
  }
}
