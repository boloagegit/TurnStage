{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turnstage.dev/schemas/turnstage-contract-suite.schema.json",
  "title": "TurnStage functional test suite",
  "type": "object",
  "required": ["format", "version", "id", "name", "cases"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "turnstage-contract-suite" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "maxLength": 10000 },
    "sourceBinding": { "$ref": "./turnstage-profile.schema.json#/$defs/sourceBinding" },
    "cases": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "name", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "maxLength": 10000 },
        "tags": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "sourceBinding": { "$ref": "./turnstage-profile.schema.json#/$defs/sourceBinding" },
        "enabled": { "type": "boolean" },
        "controls": { "type": "object", "additionalProperties": true },
        "steps": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/step" } },
        "assertions": { "$ref": "./turnstage-profile.schema.json#/$defs/assertions" },
        "comparison": { "$ref": "./turnstage-profile.schema.json#/$defs/scenarioComparison" },
        "performance": { "$ref": "./turnstage-profile.schema.json#/$defs/scenarioPerformance" },
        "faults": { "$ref": "./turnstage-profile.schema.json#/$defs/scenarioFaults" }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "input"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string" },
        "input": { "type": "string", "minLength": 1 },
        "assertions": { "$ref": "./turnstage-profile.schema.json#/$defs/assertions" }
      }
    }
  }
}
