{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/turnstage-profile.schema.json",
  "title": "TurnStage Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "conversation", "stream"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "environment": { "type": "string" },
    "controls": { "type": "array", "items": { "$ref": "#/$defs/control" } },
    "opening": { "$ref": "#/$defs/opening" },
    "conversation": {
      "type": "object", "required": ["send"], "additionalProperties": false,
      "properties": { "send": { "$ref": "#/$defs/request" }, "stop": { "$ref": "#/$defs/stop" } }
    },
    "stream": { "$ref": "#/$defs/stream" },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preset": { "enum": ["chat-only", "split-inspector", "chat-with-metrics", "compact"] },
            "inspectorPosition": { "enum": ["right", "bottom"] },
            "inspectorWidth": { "type": "integer", "minimum": 240, "maximum": 960 }
          }
        },
        "composer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "placeholder": { "type": "string" },
            "multiline": { "type": "boolean" },
            "enterBehavior": { "enum": ["send", "newline"] },
            "shiftEnterBehavior": { "enum": ["send", "newline"] },
            "showStopWhileStreaming": { "type": "boolean" }
          }
        },
        "streaming": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "effect": { "enum": ["none", "caret", "dots", "shimmer"] },
            "speedMs": { "type": "integer", "minimum": 400, "maximum": 4000 },
            "intensityPercent": { "type": "integer", "minimum": 10, "maximum": 100 }
          }
        },
        "locks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "whileTurnActive": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "disable": { "type": "array", "items": { "type": "string" } },
                "allow": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        "components": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "visible": { "type": "boolean" },
              "label": { "type": "string" },
              "collapsible": { "type": "boolean" },
              "defaultCollapsed": { "type": "boolean" }
            }
          }
        },
        "messageActions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["message.copy", "message.retry", "message.editAndResend", "message.inspectRaw"] }
        },
        "messageActionVisibility": { "enum": ["always", "interaction"] }
      }
    },
    "history": { "type": "object", "additionalProperties": true },
    "errorPolicy": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "security": { "type": "object", "additionalProperties": false, "properties": { "allowedUriSchemes": { "type": "array", "items": { "enum": ["https", "http", "file"] } }, "allowedDomains": { "type": "array", "items": { "type": "string" } }, "allowedCommands": { "type": "array", "items": { "type": "string" } } } },
    "metrics": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }, "messageEnabled": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } },
    "tests": { "$ref": "#/$defs/tests" }
  },
  "$defs": {
    "control": { "type": "object", "required": ["id", "type", "label"], "additionalProperties": true, "properties": { "id": { "type": "string" }, "type": { "enum": ["select", "boolean", "text"] }, "label": { "type": "string" }, "persist": { "enum": ["workspace", "global", "none", "secret"] }, "options": { "type": "array", "items": { "type": "object", "required": ["label", "value"], "properties": { "label": { "type": "string" }, "value": { "type": "string" } } } } } },
    "opening": { "type": "object", "required": ["mode"], "additionalProperties": true, "properties": { "mode": { "enum": ["static", "request", "disabled"] }, "message": { "type": "string" }, "starters": { "type": "array", "items": { "$ref": "#/$defs/starter" } }, "request": { "$ref": "#/$defs/request" } } },
    "starter": { "type": "object", "required": ["id", "label", "prompt", "behavior"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "prompt": { "type": "string" }, "behavior": { "enum": ["send", "fill", "action"] }, "actionId": { "type": "string" } } },
    "condition": { "type": "object", "additionalProperties": false, "properties": { "path": { "type": "string" }, "event": { "type": "string" }, "operator": { "enum": ["equals", "notEquals", "exists", "notExists", "oneOf", "contains", "startsWith", "endsWith", "regex"] }, "value": {} } },
    "request": { "type": "object", "required": ["method", "url"], "additionalProperties": true, "properties": { "method": { "enum": ["POST", "GET", "PUT", "PATCH", "DELETE"] }, "url": { "type": "string" }, "headers": { "type": "object", "additionalProperties": { "type": "string" } }, "body": {}, "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 900000 }, "idleTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 900000 }, "reconnect": { "type": "object", "additionalProperties": false, "properties": { "maxAttempts": { "type": "integer", "minimum": 0, "maximum": 5 }, "baseDelayMs": { "type": "integer", "minimum": 0, "maximum": 30000 }, "maxDelayMs": { "type": "integer", "minimum": 0, "maximum": 120000 }, "retryOnStatuses": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "integer", "minimum": 400, "maximum": 599 } } } }, "redirectPolicy": { "enum": ["same-origin", "follow", "error"] }, "maxRedirects": { "type": "integer", "minimum": 0, "maximum": 10 }, "variants": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "body"], "properties": { "id": { "type": "string" }, "when": { "$ref": "#/$defs/condition" }, "body": {}, "headers": { "type": "object", "additionalProperties": { "type": "string" } } } } } } },
    "stop": { "type": "object", "required": ["strategy"], "additionalProperties": true, "properties": { "strategy": { "enum": ["abortOnly", "abortThenRequest"] }, "request": { "$ref": "#/$defs/request" }, "requiredContext": { "type": "array", "items": { "type": "string" } } } },
    "stream": { "type": "object", "required": ["transport", "mappings"], "additionalProperties": false, "properties": { "transport": { "enum": ["sse", "ndjson", "json", "text-stream", "fixture"] }, "dataFormat": { "enum": ["json", "text"] }, "mappingMode": { "enum": ["firstMatch", "allMatches"] }, "unexpectedEndPolicy": { "enum": ["fail", "completeWithWarning"] }, "doneValue": { "type": "string" }, "mappings": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "match", "emit"], "properties": { "id": { "type": "string" }, "match": { "$ref": "#/$defs/condition" }, "emit": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" } }, "additionalProperties": true }, "continue": { "type": "boolean" } } } } } },
    "tests": {
      "type": "object",
      "required": ["scenarios"],
      "additionalProperties": false,
      "properties": {
        "scenarios": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/scenario" } },
        "adversarialSuites": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\\\)(?!.*://).+\\.adversarial\\.(?:jsonc|json)$" } },
        "reporting": { "$ref": "#/$defs/scenarioReporting" },
        "visual": { "$ref": "#/$defs/scenarioVisual" },
        "qualityRubrics": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/qualityRubric" } },
        "campaigns": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/testCampaign" } }
      }
    },
    "testCampaign": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "selectors": { "$ref": "#/$defs/campaignSelectors" },
        "runPolicy": { "$ref": "#/$defs/campaignRunPolicy" },
        "coverageTags": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
      }
    },
    "campaignSelectors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caseIds": { "type": "array", "maxItems": 500, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "suiteIds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "tags": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "tagMode": { "enum": ["all", "any"] }
      }
    },
    "campaignRunPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 100 },
        "failFast": { "type": "boolean" },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 8 },
        "maxRequests": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "maxDurationMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 }
      }
    },
    "qualityRubric": {
      "type": "object",
      "required": ["id", "name", "criteria"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 256 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "criteria": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {
            "type": "object", "required": ["id", "label", "description"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 256 },
              "label": { "type": "string", "minLength": 1, "maxLength": 120 },
              "description": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "name", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tags": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "sourceBinding": { "$ref": "#/$defs/sourceBinding" },
        "controls": { "type": "object", "additionalProperties": true },
        "steps": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/scenarioStep" } },
        "assertions": { "$ref": "#/$defs/assertions" },
        "comparison": { "$ref": "#/$defs/scenarioComparison" },
        "performance": { "$ref": "#/$defs/scenarioPerformance" },
        "faults": { "$ref": "#/$defs/scenarioFaults" },
        "adversarial": { "$ref": "#/$defs/scenarioAdversarial" }
      }
    },
    "scenarioReporting": {
      "type": "object",
      "required": ["formats", "outputDirectory"],
      "additionalProperties": false,
      "properties": {
        "formats": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["json", "junit", "html"] } },
        "outputDirectory": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\\\)(?!.*://).+$" }
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sourceGlobs": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "components": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "endpoints": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
        "riskTags": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
      }
    },
    "scenarioVisual": {
      "type": "object",
      "required": ["baselineDirectory"],
      "additionalProperties": false,
      "properties": {
        "baselineDirectory": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\\\\)(?!.*://).+$" },
        "maxDifferencePercent": { "type": "number", "minimum": 0, "maximum": 100 },
        "channelTolerance": { "type": "integer", "minimum": 0, "maximum": 255 }
      }
    },
    "scenarioComparisonTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "maxLength": 100 },
        "environment": { "type": "string" },
        "controls": { "type": "object", "additionalProperties": true }
      }
    },
    "scenarioComparison": {
      "type": "object",
      "required": ["baseline", "candidate"],
      "additionalProperties": false,
      "properties": {
        "baseline": { "$ref": "#/$defs/scenarioComparisonTarget" },
        "candidate": { "$ref": "#/$defs/scenarioComparisonTarget" },
        "ignorePaths": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
      }
    },
    "scenarioPerformance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thresholds": { "$ref": "#/$defs/scenarioPerformanceThresholds" },
        "regression": { "$ref": "#/$defs/scenarioPerformanceRegression" }
      }
    },
    "scenarioPerformanceThresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario.durationMs": { "type": "number", "minimum": 0, "maximum": 900000 },
        "metrics.headersLatency": { "type": "number", "minimum": 0, "maximum": 900000 },
        "metrics.firstChunkLatency": { "type": "number", "minimum": 0, "maximum": 900000 },
        "metrics.firstEventLatency": { "type": "number", "minimum": 0, "maximum": 900000 },
        "metrics.ttft": { "type": "number", "minimum": 0, "maximum": 900000 },
        "metrics.streamDuration": { "type": "number", "minimum": 0, "maximum": 900000 },
        "metrics.totalDuration": { "type": "number", "minimum": 0, "maximum": 900000 },
        "metrics.averageEventGap": { "type": "number", "minimum": 0, "maximum": 900000 },
        "metrics.maxEventGap": { "type": "number", "minimum": 0, "maximum": 900000 }
      }
    },
    "scenarioPerformanceRegression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenario.durationMs": { "$ref": "#/$defs/scenarioRegressionLimit" },
        "metrics.headersLatency": { "$ref": "#/$defs/scenarioRegressionLimit" },
        "metrics.firstChunkLatency": { "$ref": "#/$defs/scenarioRegressionLimit" },
        "metrics.firstEventLatency": { "$ref": "#/$defs/scenarioRegressionLimit" },
        "metrics.ttft": { "$ref": "#/$defs/scenarioRegressionLimit" },
        "metrics.streamDuration": { "$ref": "#/$defs/scenarioRegressionLimit" },
        "metrics.totalDuration": { "$ref": "#/$defs/scenarioRegressionLimit" },
        "metrics.averageEventGap": { "$ref": "#/$defs/scenarioRegressionLimit" },
        "metrics.maxEventGap": { "$ref": "#/$defs/scenarioRegressionLimit" }
      }
    },
    "scenarioRegressionLimit": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "maxIncreaseMs": { "type": "number", "minimum": 0, "maximum": 900000 },
        "maxIncreasePercent": { "type": "number", "minimum": 0, "maximum": 10000 }
      }
    },
    "scenarioFaults": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "delayBeforeRequestMs": { "type": "integer", "minimum": 0, "maximum": 30000 },
        "delayPerChunkMs": { "type": "integer", "minimum": 0, "maximum": 30000 },
        "httpStatus": { "type": "integer", "minimum": 400, "maximum": 599 },
        "disconnectAfterEvents": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "corruptEventAt": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "scenarioAdversarial": {
      "type": "object",
      "required": ["forbid"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["singleTurn", "multiTurn"] },
        "maxTurns": { "type": "integer", "minimum": 1, "maximum": 10 },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "stopOnAttackSucceeded": { "type": "boolean" },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 50 },
        "failFast": { "type": "boolean" },
        "forbid": { "$ref": "#/$defs/adversarialForbid" }
      }
    },
    "adversarialForbid": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": { "type": "array", "maxItems": 50, "items": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 256 }, { "$ref": "#/$defs/adversarialContentRule" }] } },
        "urls": { "type": "boolean" },
        "ctas": { "type": "boolean" },
        "tools": { "type": "boolean" },
        "events": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } }
      },
      "anyOf": [
        { "required": ["content"] },
        { "properties": { "urls": { "const": true } }, "required": ["urls"] },
        { "properties": { "ctas": { "const": true } }, "required": ["ctas"] },
        { "properties": { "tools": { "const": true } }, "required": ["tools"] },
        { "required": ["events"] }
      ]
    },
    "adversarialContentRule": {
      "type": "object",
      "required": ["match", "value"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "maxLength": 100 },
        "match": { "enum": ["contains", "regex"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 256 },
        "caseSensitive": { "type": "boolean" }
      }
    },
    "scenarioStep": {
      "type": "object",
      "required": ["id", "input"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string" },
        "input": { "type": "string", "minLength": 1 },
        "assertions": { "$ref": "#/$defs/assertions" },
        "additionalForbid": { "$ref": "#/$defs/adversarialForbid" }
      }
    },
    "assertions": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/assertion" }
    },
    "assertion": {
      "type": "object",
      "required": ["path", "operator"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string", "maxLength": 512 },
        "operator": { "enum": ["equals", "notEquals", "exists", "notExists", "contains", "regex", "oneOf", "lessThan", "lessThanOrEqual", "greaterThan", "greaterThanOrEqual", "sequenceEquals", "sequenceContains"] },
        "value": {},
        "message": { "type": "string" }
      }
    }
  }
}
