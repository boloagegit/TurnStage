{
  "name": "turnstage",
  "displayName": "TurnStage",
  "description": "%extension.description%",
  "version": "0.13.0",
  "publisher": "turnstage",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "sse",
    "chat",
    "agent",
    "stream",
    "testing"
  ],
  "main": "dist/extension.js",
  "bin": {
    "turnstage": "dist/cli.js"
  },
  "l10n": "./l10n",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%workspaceTrust.description%",
      "restrictedConfigurations": []
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onView:turnstage.profiles",
    "onCustomEditor:turnstage.profileEditor",
    "onCommand:turnstage.initializeWorkspace",
    "onCommand:turnstage.initializeUser",
    "onCommand:turnstage.createProfile",
    "onCommand:turnstage.importProfile",
    "onCommand:turnstage.duplicateProfile",
    "onCommand:turnstage.deleteProfile",
    "onCommand:turnstage.openProfile",
    "onCommand:turnstage.openProfileSection",
    "onCommand:turnstage.openGuide",
    "onCommand:turnstage.changeDisplayLanguage",
    "onCommand:turnstage.configureProfile",
    "onCommand:turnstage.runProfile",
    "onCommand:turnstage.startSession",
    "onCommand:turnstage.abortRequest",
    "onCommand:turnstage.newConversation",
    "onCommand:turnstage.clearConversation",
    "onCommand:turnstage.validateProfile",
    "onCommand:turnstage.openAsText",
    "onCommand:turnstage.selectEnvironment",
    "onCommand:turnstage.openEnvironment",
    "onCommand:turnstage.setSecret",
    "onCommand:turnstage.removeSecret",
    "onCommand:turnstage.listSecretNames",
    "onCommand:turnstage.replayRun",
    "onCommand:turnstage.importRun",
    "onCommand:turnstage.exportRun",
    "onCommand:turnstage.openOutput",
    "onCommand:turnstage.runContractTests",
    "onCommand:turnstage.exportTestReport",
    "onCommand:turnstage.exportEvidenceBundle",
    "onCommand:turnstage.openTestEvidence",
    "onCommand:turnstage.migrateProfile",
    "onCommand:turnstage.refreshProfiles",
    "workspaceContains:**/*.turnstage.jsonc"
  ],
  "contributes": {
    "commands": [
      {
        "command": "turnstage.initializeWorkspace",
        "title": "%command.initializeWorkspace%",
        "category": "%command.category%",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.initializeUser",
        "title": "%command.initializeUser%",
        "category": "%command.category%",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.createProfile",
        "title": "%command.createProfile%",
        "category": "%command.category%",
        "icon": "$(new-file)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.importProfile",
        "title": "%command.importProfile%",
        "category": "%command.category%",
        "icon": "$(cloud-download)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.duplicateProfile",
        "title": "%command.duplicateProfile%",
        "category": "%command.category%",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.deleteProfile",
        "title": "%command.deleteProfile%",
        "category": "%command.category%",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.openProfile",
        "title": "%command.openProfile%",
        "category": "%command.category%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "turnstage.openProfileSection",
        "title": "%command.openProfileSection%",
        "category": "%command.category%"
      },
      {
        "command": "turnstage.openGuide",
        "title": "%command.openGuide%",
        "category": "%command.category%",
        "icon": "$(book)"
      },
      {
        "command": "turnstage.changeDisplayLanguage",
        "title": "%command.changeDisplayLanguage%",
        "category": "%command.category%"
      },
      {
        "command": "turnstage.configureProfile",
        "title": "%command.configureProfile%",
        "category": "%command.category%",
        "icon": "$(settings)"
      },
      {
        "command": "turnstage.runProfile",
        "title": "%command.runProfile%",
        "category": "%command.category%",
        "icon": "$(play)"
      },
      {
        "command": "turnstage.startSession",
        "title": "%command.startSession%",
        "category": "%command.category%",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.abortRequest",
        "title": "%command.abortRequest%",
        "category": "%command.category%"
      },
      {
        "command": "turnstage.newConversation",
        "title": "%command.newConversation%",
        "category": "%command.category%",
        "icon": "$(add)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.clearConversation",
        "title": "%command.clearConversation%",
        "category": "%command.category%"
      },
      {
        "command": "turnstage.validateProfile",
        "title": "%command.validateProfile%",
        "category": "%command.category%"
      },
      {
        "command": "turnstage.openAsText",
        "title": "%command.openAsText%",
        "category": "%command.category%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "turnstage.selectEnvironment",
        "title": "%command.selectEnvironment%",
        "category": "%command.category%",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.openEnvironment",
        "title": "%command.openEnvironment%",
        "category": "%command.category%"
      },
      {
        "command": "turnstage.setSecret",
        "title": "%command.setSecret%",
        "category": "%command.category%",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.removeSecret",
        "title": "%command.removeSecret%",
        "category": "%command.category%",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.listSecretNames",
        "title": "%command.listSecretNames%",
        "category": "%command.category%",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.replayRun",
        "title": "%command.replayRun%",
        "category": "%command.category%"
      },
      {
        "command": "turnstage.importRun",
        "title": "%command.importRun%",
        "category": "%command.category%",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.exportRun",
        "title": "%command.exportRun%",
        "category": "%command.category%",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.openOutput",
        "title": "%command.openOutput%",
        "category": "%command.category%"
      },
      {
        "command": "turnstage.runContractTests",
        "title": "%command.runContractTests%",
        "category": "%command.category%",
        "icon": "$(run-all)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.exportTestReport",
        "title": "%command.exportTestReport%",
        "category": "%command.category%",
        "icon": "$(export)"
      },
      {
        "command": "turnstage.exportEvidenceBundle",
        "title": "%command.exportEvidenceBundle%",
        "category": "%command.category%",
        "icon": "$(package)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.openTestEvidence",
        "title": "%command.openTestEvidence%",
        "category": "%command.category%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "turnstage.migrateProfile",
        "title": "%command.migrateProfile%",
        "category": "%command.category%",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "turnstage.refreshProfiles",
        "title": "%command.refreshProfiles%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "turnstage",
          "title": "%view.container%",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "turnstage": [
        {
          "id": "turnstage.profiles",
          "name": "%view.profiles%",
          "icon": "media/activity.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "turnstage.profiles",
        "contents": "%view.profiles.welcome%",
        "when": "isWorkspaceTrusted"
      },
      {
        "view": "turnstage.profiles",
        "contents": "%view.profiles.welcomeRestricted%",
        "when": "!isWorkspaceTrusted"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "tryDemo",
            "title": "%walkthrough.step.demo.title%",
            "description": "%walkthrough.step.demo.description%",
            "media": {
              "markdown": "%walkthrough.step.demo.media%"
            },
            "completionEvents": [
              "onCommand:turnstage.runProfile"
            ]
          },
          {
            "id": "createProfile",
            "title": "%walkthrough.step.profile.title%",
            "description": "%walkthrough.step.profile.description%",
            "media": {
              "markdown": "%walkthrough.step.profile.media%"
            },
            "completionEvents": [
              "onCommand:turnstage.createProfile",
              "onCommand:turnstage.importProfile",
              "onCommand:turnstage.initializeWorkspace",
              "onCommand:turnstage.initializeUser"
            ]
          },
          {
            "id": "configureFlow",
            "title": "%walkthrough.step.configure.title%",
            "description": "%walkthrough.step.configure.description%",
            "media": {
              "markdown": "%walkthrough.step.configure.media%"
            },
            "completionEvents": [
              "onCommand:turnstage.configureProfile",
              "onCommand:turnstage.openAsText"
            ]
          },
          {
            "id": "inspectRun",
            "title": "%walkthrough.step.inspect.title%",
            "description": "%walkthrough.step.inspect.description%",
            "media": {
              "markdown": "%walkthrough.step.inspect.media%"
            },
            "completionEvents": [
              "onCommand:turnstage.runProfile",
              "onCommand:turnstage.replayRun",
              "onCommand:turnstage.openOutput"
            ]
          }
        ]
      }
    ],
    "submenus": [
      {
        "id": "turnstage.profileSession",
        "label": "%submenu.profileSession%"
      },
      {
        "id": "turnstage.profileTools",
        "label": "%submenu.profileTools%"
      },
      {
        "id": "turnstage.profileManagement",
        "label": "%submenu.profileManagement%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "turnstage.createProfile",
          "when": "view == turnstage.profiles && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "turnstage.importProfile",
          "when": "view == turnstage.profiles && isWorkspaceTrusted",
          "group": "navigation@2"
        },
        {
          "command": "turnstage.refreshProfiles",
          "when": "view == turnstage.profiles",
          "group": "navigation@4"
        },
        {
          "command": "turnstage.openGuide",
          "when": "view == turnstage.profiles",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "turnstage.createProfile",
          "when": "view == turnstage.profiles && (viewItem == turnstageProfileScope.user || viewItem == turnstageProfileScope.workspace) && isWorkspaceTrusted",
          "group": "inline@1"
        },
        {
          "command": "turnstage.importProfile",
          "when": "view == turnstage.profiles && (viewItem == turnstageProfileScope.user || viewItem == turnstageProfileScope.workspace) && isWorkspaceTrusted",
          "group": "inline@2"
        },
        {
          "command": "turnstage.initializeUser",
          "when": "view == turnstage.profiles && viewItem == turnstageProfileScope.user && isWorkspaceTrusted",
          "group": "management@1"
        },
        {
          "command": "turnstage.runProfile",
          "when": "view == turnstage.profiles && viewItem == turnstageProfile && isWorkspaceTrusted",
          "group": "inline@1"
        },
        {
          "command": "turnstage.openProfile",
          "when": "view == turnstage.profiles && viewItem == turnstageProfile",
          "group": "inline@2"
        },
        {
          "command": "turnstage.configureProfile",
          "when": "view == turnstage.profiles && viewItem == turnstageProfile",
          "group": "inline@3"
        },
        {
          "submenu": "turnstage.profileSession",
          "when": "view == turnstage.profiles && viewItem == turnstageProfile",
          "group": "turnstage@1"
        },
        {
          "submenu": "turnstage.profileTools",
          "when": "view == turnstage.profiles && viewItem == turnstageProfile",
          "group": "turnstage@2"
        },
        {
          "submenu": "turnstage.profileManagement",
          "when": "view == turnstage.profiles && viewItem == turnstageProfile && isWorkspaceTrusted",
          "group": "turnstage@3"
        }
      ],
      "turnstage.profileSession": [
        {
          "command": "turnstage.startSession",
          "when": "isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "turnstage.selectEnvironment",
          "when": "isWorkspaceTrusted",
          "group": "environment@1"
        },
        {
          "command": "turnstage.openEnvironment",
          "group": "environment@2"
        }
      ],
      "turnstage.profileTools": [
        {
          "command": "turnstage.validateProfile",
          "group": "validation@1"
        },
        {
          "command": "turnstage.openAsText",
          "group": "validation@2"
        },
        {
          "command": "turnstage.migrateProfile",
          "when": "isWorkspaceTrusted",
          "group": "advanced@1"
        },
        {
          "command": "turnstage.replayRun",
          "group": "advanced@2"
        },
        {
          "command": "turnstage.exportRun",
          "when": "isWorkspaceTrusted",
          "group": "advanced@3"
        }
      ],
      "turnstage.profileManagement": [
        {
          "command": "turnstage.duplicateProfile",
          "group": "management@1"
        },
        {
          "command": "turnstage.deleteProfile",
          "group": "management@2"
        }
      ],
      "editor/title": [
        {
          "command": "turnstage.newConversation",
          "when": "activeCustomEditorId == turnstage.profileEditor && isWorkspaceTrusted && !turnstage.turnActive",
          "group": "navigation@1"
        },
        {
          "command": "turnstage.openAsText",
          "when": "activeCustomEditorId == turnstage.profileEditor",
          "group": "1_modification@1"
        }
      ],
      "testing/message/content": [
        {
          "command": "turnstage.openTestEvidence",
          "when": "testMessage =~ /^turnstage\\.evidence\\./",
          "group": "navigation@1"
        }
      ],
      "testing/message/context": [
        {
          "command": "turnstage.openTestEvidence",
          "when": "testMessage =~ /^turnstage\\.evidence\\./",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "turnstage.openTestEvidence",
          "when": "false"
        },
        {
          "command": "turnstage.duplicateProfile",
          "when": "false"
        },
        {
          "command": "turnstage.deleteProfile",
          "when": "false"
        },
        {
          "command": "turnstage.openProfile",
          "when": "false"
        },
        {
          "command": "turnstage.openProfileSection",
          "when": "false"
        },
        {
          "command": "turnstage.configureProfile",
          "when": "false"
        },
        {
          "command": "turnstage.startSession",
          "when": "false"
        },
        {
          "command": "turnstage.abortRequest",
          "when": "false"
        },
        {
          "command": "turnstage.newConversation",
          "when": "false"
        },
        {
          "command": "turnstage.clearConversation",
          "when": "false"
        },
        {
          "command": "turnstage.validateProfile",
          "when": "false"
        },
        {
          "command": "turnstage.openAsText",
          "when": "activeCustomEditorId == turnstage.profileEditor"
        },
        {
          "command": "turnstage.selectEnvironment",
          "when": "false"
        },
        {
          "command": "turnstage.openEnvironment",
          "when": "false"
        },
        {
          "command": "turnstage.replayRun",
          "when": "false"
        },
        {
          "command": "turnstage.exportRun",
          "when": "false"
        },
        {
          "command": "turnstage.migrateProfile",
          "when": "false"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "turnstage.profileEditor",
        "displayName": "%editor.profile%",
        "selector": [
          {
            "filenamePattern": "*.turnstage.jsonc"
          }
        ],
        "priority": "default"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.adversarial.jsonc",
        "url": "./resources/schemas/turnstage-adversarial-suite.schema.json"
      },
      {
        "fileMatch": "*.adversarial.json",
        "url": "./resources/schemas/turnstage-adversarial-suite.schema.json"
      },
      {
        "fileMatch": "*.turnstage.jsonc",
        "url": "./resources/schemas/turnstage-profile.schema.json"
      },
      {
        "fileMatch": "*.environment.jsonc",
        "url": "./resources/schemas/turnstage-environment.schema.json"
      }
    ],
    "languageModelTools": [
      {
        "name": "turnstage_find_tests",
        "toolReferenceName": "turnstage_find_tests",
        "displayName": "Find TurnStage tests",
        "userDescription": "Find bounded TurnStage behavior tests and their estimated work.",
        "modelDescription": "Find matching TurnStage profiles, suites, cases, or steps. Use this before running tests. Results are bounded and paginated; do not infer that an empty page means no tests without checking the total and nextCursor.",
        "canBeReferencedInPrompt": true,
        "icon": "$(search)",
        "tags": [
          "turnstage",
          "testing",
          "read-only"
        ],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "query": {
              "type": "string",
              "maxLength": 256,
              "description": "Optional case-insensitive label or id search."
            },
            "profileId": {
              "type": "string",
              "maxLength": 512
            },
            "suiteId": {
              "type": "string",
              "maxLength": 512
            },
            "caseId": {
              "type": "string",
              "maxLength": 512
            },
            "tag": {
              "type": "string",
              "maxLength": 64
            },
            "changedFiles": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1000,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "description": "Workspace-relative changed paths used with explicit sourceBinding values."
            },
            "includeUnbound": {
              "type": "boolean",
              "description": "Explicitly include unbound cases when changedFiles are supplied; defaults to false."
            },
            "includeSteps": {
              "type": "boolean",
              "description": "Include leaf step items; defaults to false."
            },
            "cursor": {
              "type": "string",
              "pattern": "^[0-9]{1,6}$",
              "maxLength": 6
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        }
      },
      {
        "name": "turnstage_run_tests",
        "toolReferenceName": "turnstage_run_tests",
        "displayName": "Run TurnStage tests",
        "userDescription": "Run selected TurnStage behavior tests after showing a network preflight.",
        "modelDescription": "Run TurnStage tests through the shared execution service. This may issue network requests and resolve configured credentials, so always respect the confirmation and preflight. Restricted Mode blocks network execution. Results contain only bounded summaries and a cursor, never full transcripts.",
        "canBeReferencedInPrompt": true,
        "icon": "$(play)",
        "tags": [
          "turnstage",
          "testing",
          "network"
        ],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "selectors": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "maxLength": 512
              },
              "description": "Optional explicit test ids. An empty array is not meaningful."
            },
            "repetitions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Optional repetition override, capped by the adversarial suite safety limit."
            },
            "failFast": {
              "type": "boolean"
            },
            "expectedIntegrity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profileFingerprint"
              ],
              "properties": {
                "profileFingerprint": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "suiteFingerprint": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "caseFingerprints": {
                  "type": "object",
                  "maxProperties": 100,
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            },
            "cursor": {
              "type": "string",
              "pattern": "^[0-9]{1,6}$",
              "maxLength": 6
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        }
      },
      {
        "name": "turnstage_inspect_failure",
        "toolReferenceName": "turnstage_inspect_failure",
        "displayName": "Inspect TurnStage failure",
        "userDescription": "Inspect one bounded, redacted TurnStage evidence capsule.",
        "modelDescription": "Inspect a TurnStage failure by run id and optionally failure id. Returns EvidenceCapsuleV1 with stable Chat, Network, and Event references, outcome, completeness, fingerprints, and disclosure metadata. Raw prompts, headers, bodies, and secrets are omitted.",
        "canBeReferencedInPrompt": true,
        "icon": "$(warning)",
        "tags": [
          "turnstage",
          "testing",
          "evidence",
          "read-only"
        ],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runId"
          ],
          "properties": {
            "runId": {
              "type": "string",
              "maxLength": 512
            },
            "failureId": {
              "type": "string",
              "maxLength": 512
            },
            "includeEvents": {
              "type": "boolean",
              "description": "Request event references only; raw event payloads are never returned."
            },
            "cursor": {
              "type": "string",
              "pattern": "^[0-9]{1,6}$",
              "maxLength": 6
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        }
      },
      {
        "name": "turnstage_draft_regression",
        "toolReferenceName": "turnstage_draft_regression",
        "displayName": "Draft TurnStage regression",
        "userDescription": "Validate a proposed regression draft without changing workspace files.",
        "modelDescription": "Validate and return a declarative TurnStage scenario or adversarial regression draft associated with a prior failure. This tool is draft-only: it never writes or edits workspace files. The draft must use bounded ids, fixed turns, safe assertions, and (for adversarial drafts) at least one prohibited effect.",
        "canBeReferencedInPrompt": true,
        "icon": "$(diff)",
        "tags": [
          "turnstage",
          "testing",
          "draft",
          "read-only"
        ],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runId",
            "failureId",
            "draft"
          ],
          "properties": {
            "runId": {
              "type": "string",
              "maxLength": 512
            },
            "failureId": {
              "type": "string",
              "maxLength": 512
            },
            "sourceEvidenceId": {
              "type": "string",
              "maxLength": 512
            },
            "draft": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "steps"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "maxLength": 512
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "description": {
                  "type": "string",
                  "maxLength": 4096
                },
                "tags": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "maxLength": 64
                  }
                },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "input"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]*$",
                        "maxLength": 512
                      },
                      "name": {
                        "type": "string",
                        "maxLength": 256
                      },
                      "input": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "additionalForbid": {
                        "type": "object"
                      }
                    }
                  }
                },
                "assertions": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "type": "object"
                  }
                },
                "adversarial": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "forbid"
                  ],
                  "properties": {
                    "mode": {
                      "type": "string",
                      "enum": [
                        "singleTurn",
                        "multiTurn"
                      ]
                    },
                    "maxTurns": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    },
                    "timeoutMs": {
                      "type": "integer",
                      "minimum": 1000,
                      "maximum": 300000
                    },
                    "stopOnAttackSucceeded": {
                      "type": "boolean"
                    },
                    "repetitions": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 50
                    },
                    "failFast": {
                      "type": "boolean"
                    },
                    "forbid": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "name": "turnstage_validate_tests",
        "toolReferenceName": "turnstage_validate_tests",
        "displayName": "Validate TurnStage tests",
        "userDescription": "Validate test structure and report test-integrity status.",
        "modelDescription": "Validate TurnStage profiles, suites, and cases without issuing network requests. Returns bounded diagnostics and fail-closed integrity status when an expected profile or suite fingerprint is supplied.",
        "canBeReferencedInPrompt": true,
        "icon": "$(check)",
        "tags": [
          "turnstage",
          "testing",
          "validation",
          "read-only"
        ],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "profileId": {
              "type": "string",
              "maxLength": 512
            },
            "suiteId": {
              "type": "string",
              "maxLength": 512
            },
            "caseId": {
              "type": "string",
              "maxLength": 512
            },
            "expectedIntegrity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profileFingerprint"
              ],
              "properties": {
                "profileFingerprint": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "suiteFingerprint": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "caseFingerprints": {
                  "type": "object",
                  "maxProperties": 100,
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            },
            "cursor": {
              "type": "string",
              "pattern": "^[0-9]{1,6}$",
              "maxLength": 6
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          }
        }
      },
      {
        "name": "turnstage_analyze_run",
        "toolReferenceName": "turnstage_analyze_run",
        "displayName": "Analyze TurnStage run",
        "userDescription": "Explain failure, timing, stability, comparison, or profile configuration from bounded TurnStage evidence.",
        "modelDescription": "Run TurnStage's deterministic diagnostic rules over sanitized evidence. The result distinguishes facts from bounded hypotheses using strong, moderate, or limited evidence. Raw prompts, response text, headers, bodies, secrets, and full URLs are excluded.",
        "canBeReferencedInPrompt": true,
        "icon": "$(pulse)",
        "tags": [
          "turnstage",
          "diagnostics",
          "read-only"
        ],
        "inputSchema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "runId": {
              "type": "string",
              "maxLength": 512
            },
            "evidenceId": {
              "type": "string",
              "maxLength": 512
            },
            "profile": {
              "type": "string",
              "maxLength": 512
            },
            "mode": {
              "enum": [
                "failure",
                "performance",
                "stability",
                "comparison",
                "configuration"
              ]
            }
          },
          "oneOf": [
            {
              "properties": {
                "mode": {
                  "enum": [
                    "configuration"
                  ]
                }
              },
              "required": [
                "mode",
                "profile"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "runId"
                    ]
                  },
                  {
                    "required": [
                      "evidenceId"
                    ]
                  }
                ]
              }
            },
            {
              "properties": {
                "mode": {
                  "enum": [
                    "failure",
                    "performance",
                    "stability",
                    "comparison"
                  ]
                }
              },
              "required": [
                "mode"
              ],
              "oneOf": [
                {
                  "required": [
                    "runId"
                  ],
                  "not": {
                    "required": [
                      "evidenceId"
                    ]
                  }
                },
                {
                  "required": [
                    "evidenceId"
                  ],
                  "not": {
                    "required": [
                      "runId"
                    ]
                  }
                }
              ],
              "not": {
                "required": [
                  "profile"
                ]
              }
            }
          ]
        }
