              "type": "string",
              "maxLength": 512
            },
            "expectedProfileDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "operations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 256
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 10000
                        }
                      ]
                    }
                  },
                  "operation": {
                    "enum": [
                      "set",
                      "remove"
                    ],
                    "default": "set"
                  },
                  "value": {},
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "category": {
                    "enum": [
                      "request-timing",
                      "retry-timing",
                      "stream-parser",
                      "mapping"
                    ]
