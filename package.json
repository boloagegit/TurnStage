              "type": "string",
              "maxLength": 512
            },
            "draft": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "format",
                "version",
                "profileDigest",
                "sourceDigest",
                "updatedProfileDigest",
                "sourceLength",
