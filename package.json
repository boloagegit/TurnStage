      {
        "name": "turnstage_apply_profile_patch",
        "toolReferenceName": "turnstage_apply_profile_patch",
        "displayName": "Apply TurnStage profile patch",
        "userDescription": "Preview and apply a previously drafted safe profile patch after confirmation.",
        "modelDescription": "Apply an unchanged, allowlisted TurnStage profile patch. TurnStage verifies both source and profile SHA-256 digests, opens a native VS Code diff, asks for explicit confirmation, applies one WorkspaceEdit, validates and saves, and rolls back on verification failure. This tool never runs tests automatically.",
