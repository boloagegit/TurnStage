      {
        "name": "turnstage_draft_profile_patch",
        "toolReferenceName": "turnstage_draft_profile_patch",
        "displayName": "Draft TurnStage profile patch",
        "userDescription": "Draft allowlisted profile setting changes without editing files.",
        "modelDescription": "Create a digest-locked JSONC-preserving patch for allowlisted TurnStage timing, retry, parser, or mapping settings. This tool is draft-only. Secret, auth, proxy, VPN, certificate, URL, header, and arbitrary payload changes are rejected.",
        "canBeReferencedInPrompt": true,
        "icon": "$(diff-added)",
        "tags": [
          "turnstage",
          "diagnostics",
          "draft",
          "read-only"
