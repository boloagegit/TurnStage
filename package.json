                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "updatedProfileDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "sourceLength": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2097152
                },
                "updatedSourceLength": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2097152
                },
                "summary": {
                  "type": "string",
                  "maxLength": 512
