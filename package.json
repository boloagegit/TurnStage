  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test examples/mock-server --max-warnings=0",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:sse": "vitest run --config vitest.config.ts test/sseTransport.test.ts",
    "test:integration": "npm run compile && node test/integration/runTest.mjs",
    "test:visual": "npm run compile && node test/visual/profileWorkspace.visual.mjs",
    "benchmark": "vitest bench --config test/benchmark.vitest.config.ts --run",
    "mock-server": "node examples/mock-server/server.mjs",
    "package": "npm run compile && vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "npm run compile"
  },
